# rlmh: a placeholder (D-130). rlmh's postinstall (install.js) replaces this file with the compiled
# rlmh binary for this machine. It has no "#!" line on purpose: npm and Bun then link it to run
# directly, so the binary that replaces it runs with no Node or Bun in between.
# When the postinstall was skipped (bun add -g without --trust, or --ignore-scripts), a Unix shell
# or execvp runs this file with /bin/sh, and it starts the binary from the platform package. Windows
# cannot run it: there the postinstall is required.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
pkg=$(cd "$(dirname "$self")/.." && pwd -P)
case $(uname -s) in
  Darwin) keys="darwin-arm64 darwin-x64" ;;
  Linux) keys="linux-x64" ;;
  *) keys="" ;;
esac
# npm nests the platform package inside rlmh; Bun and pnpm put it beside rlmh
for dir in "$pkg/node_modules/@rlmh" "$pkg/../@rlmh"; do
  for key in $keys; do
    bin=$dir/$key/bin/rlmh
    if [ -f "$bin" ]; then
      echo 'rlmh: the install step did not run; "bun pm -g trust rlmh" makes this permanent.' >&2
      [ -x "$bin" ] || chmod +x "$bin" 2>/dev/null
      exec "$bin" "$@"
    fi
  done
done
echo "rlmh: no compiled rlmh for $(uname -sm) next to $pkg. Reinstall without --omit=optional: npm i -g rlmh" >&2
exit 1
