{
  "name": "rlm-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "rlmh": "src/main.ts"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "mkdir -p ../dist && bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/main.ts --outfile ../dist/rlmh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "ink": "8.0.0",
    "openai": "7.46.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "react-devtools-core": "8.0.0",
    "typescript": "7.0.2"
  }
}
